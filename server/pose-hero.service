[Unit]
Description=Pose Hero AI game + leaderboard
After=network.target

[Service]
Type=simple
User=posehero
Group=posehero
WorkingDirectory=/opt/pose-hero
ExecStart=/usr/bin/python3 /opt/pose-hero/server/app.py --host 0.0.0.0 --port 8080 --site /opt/pose-hero/dist --db /opt/pose-hero/server/data/pose-hero.db
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/pose-hero/server/data

[Install]
WantedBy=multi-user.target
